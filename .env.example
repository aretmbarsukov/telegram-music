# Local development values are placeholders. Do not use these in production.
NODE_ENV=development
HOST=127.0.0.1
PORT=8787
DEV_AUTH_USER_ID=100000001
# Explicitly enable the fixed local development identity. Must remain false in production.
DEV_AUTH_ENABLED=true
# Return deterministic in-process YouTube fixtures instead of making Google API requests.
YOUTUBE_MOCK_MODE=true
DATABASE_URL=postgresql://music:local_dev_only@127.0.0.1:5432/telegram_music
APP_ORIGIN=http://localhost:8787

# Server-side only. Never expose these in frontend code.
BOT_TOKEN=
# TELEGRAM_BOT_TOKEN remains accepted as a backwards-compatible alias for BOT_TOKEN.
BOT_MODE=polling
# Set APP_ORIGIN to the HTTPS URL printed by your tunnel before opening the app in Telegram.
# Production webhook deployment: BOT_MODE=webhook and configure the following two values.
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
YOUTUBE_API_KEY=
YOUTUBE_DAILY_QUOTA_LIMIT=9000
